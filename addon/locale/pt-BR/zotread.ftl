zotread-prefs-header = ZotRead
zotread-prefs-auto-detect =
    .label = Marcar itens como lidos ao abrir no leitor
zotread-prefs-show-annotations =
    .label = Exibir indicador de anotações (ponto amarelo)
zotread-prefs-color-unread = Cor de não lido
zotread-prefs-color-read = Cor de lido
zotread-prefs-color-annotated = Cor do ponto de anotação
zotread-prefs-note =
    O status de leitura é armazenado localmente nesta instalação do Zotero e não é sincronizado.
    Notas anexadas a um item não contam como anotações; anotações do leitor
    (destaques, sublinhados, notas, imagens, tinta e texto) nos anexos contam.
